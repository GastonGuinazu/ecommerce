// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// 1. GENERADOR: Crea el cliente de JS para que Nest pueda hablar con la BD
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

// 2. DATASOURCE: Define que usamos Postgres y la URL está en el archivo .env
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 3. MODELOS: Aquí definimos nuestras tablas

// Enum para roles (Postgres nativo)
enum Role {
  USER
  ADMIN
}

// Modelo de Usuario
model User {
  id        String   @id @default(uuid()) // ID tipo "b53f6c..." (más seguro)
  email     String   @unique
  password  String
  fullName  String?
  role      Role     @default(USER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]

  @@map("users") // Nombre real de la tabla en minúsculas
}

// --- CATÁLOGO DE PRODUCTOS ---

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String    @unique // Para URLs amigables: /categoria/remeras
  parentId  Int?       // Puede ser nulo (si es categoría raíz como "Hombre")
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  products  Product[] // Relación: Una categoría tiene muchos productos
  createdAt DateTime  @default(now())
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  basePrice   Decimal  @db.Decimal(10, 2) // Precio base
  isActive    Boolean  @default(true)
  images      String[]
  
  // Relaciones
  category    Category? @relation(fields: [categoryId], references: [id])
  categoryId  Int?
  
  variants    ProductVariant[] // Un producto tiene muchas variantes (Rojo M, Azul L...)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("products")
}

model ProductVariant {
  id        String  @id @default(uuid())
  sku       String  @unique // Código de barra único (ej: REM-ROJ-M)
  size      String  // S, M, L, XL, 42, 44
  color     String  // Rojo, #FF0000
  stock     Int     @default(0) // El stock vive AQUÍ, no en el producto padre
  images    String[]
  
  // Si el XXL es más caro, aquí sumamos la diferencia
  priceAdjustment Decimal @default(0) @db.Decimal(10, 2) 

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  orderItems OrderItem[]

  @@map("product_variants")
}

// --- MÓDULO DE ÓRDENES Y PAGOS ---

// Estados posibles de una orden
enum OrderStatus {
  PENDING   // Creada, esperando pago
  PAID      // Pagada
  SHIPPED   // Enviada
  DELIVERED // Entregada
  CANCELLED // Cancelada
}

// La cabecera de la orden (Total, Cliente, Fecha)
model Order {
  id           String      @id @default(uuid())
  totalAmount  Decimal     @db.Decimal(10, 2)
  status       OrderStatus @default(PENDING)
  
  // Relación: Quién compró
  user         User        @relation(fields: [userId], references: [id])
  userId       String

  // Relación: Qué compró (Lista de ítems)
  items        OrderItem[]
  
  // Relación: Pago asociado
  payment      Payment? 

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

// El detalle de la orden (Renglones: "2 remeras rojas")
model OrderItem {
  id           String         @id @default(uuid())
  quantity     Int            // Cantidad comprada
  price        Decimal        @db.Decimal(10, 2) // PRECIO CONGELADO (Snapshot)
  
  // Relación: A qué orden pertenece
  order        Order          @relation(fields: [orderId], references: [id])
  orderId      String
  
  // Relación: Qué producto es
  variant      ProductVariant @relation(fields: [variantId], references: [id])
  variantId    String
}

// Tabla de Pagos (para transferencias o QR)
model Payment {
  id             String   @id @default(uuid())
  amount         Decimal  @db.Decimal(10, 2)
  method         String   // Ej: "TRANSFERENCIA", "MERCADOPAGO"
  proofUrl       String?  // Foto del comprobante
  isVerified     Boolean  @default(false)
  
  order          Order    @relation(fields: [orderId], references: [id])
  orderId        String   @unique

  createdAt      DateTime @default(now())
}